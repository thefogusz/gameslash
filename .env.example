# Generate a long random password; never prefix these values with NEXT_PUBLIC_.
ADMIN_PASSWORD=
SESSION_SECRET=
# Public canonical origin for SEO, sitemap and social images. Leave empty until a custom domain is live.
GAMESLASH_SITE_URL=
# Optional Google Search Console HTML verification token (not the full meta tag).
GOOGLE_SITE_VERIFICATION=
# Server-only Vercel access token for reading this project's Web Analytics in Console.
# Use a dedicated token scoped to kirdssadee-4203s-projects. Never use NEXT_PUBLIC_.
VERCEL_ANALYTICS_TOKEN=
# Optional OAuth issuer override for isolated previews. Production defaults to https://gameslash.vercel.app.
GAMESLASH_OAUTH_ORIGIN=
# Connect a PRIVATE Vercel Blob store in the project Storage tab.
BLOB_READ_WRITE_TOKEN=
# Enable only after running the Postgres migration. Keep credentials server-side.
DATABASE_URL=
GAMESLASH_STORAGE=
# Cloudflare Worker endpoint and server-only bearer token; set storage to d1 after migration.
GAMESLASH_D1_URL=
GAMESLASH_D1_TOKEN=
# Temporary write freeze during migration; public reading remains available.
GAMESLASH_READ_ONLY=false
