# Generate a long random password; never prefix these values with NEXT_PUBLIC_.
ADMIN_PASSWORD=
SESSION_SECRET=
# Connect a PRIVATE Vercel Blob store in the project Storage tab.
BLOB_READ_WRITE_TOKEN=
# Enable only after running the Postgres migration. Keep credentials server-side.
DATABASE_URL=
GAMESLASH_STORAGE=
# Temporary write freeze during migration; public reading remains available.
GAMESLASH_READ_ONLY=false
# Optional: server-only Apify key. Runs require an operator-verified free-credit allowance.
APIFY_TOKEN=
